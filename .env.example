# Optional. A strong JWT secret is generated and saved in data/jwt.key by default.
# ADF_JWT_SECRET=use_a_random_secret_of_at_least_32_characters
# ADF_DATA_DIR=D:/path/to/private/data
# Enable only when serving over HTTPS:
# ADF_SECURE_COOKIES=1
# Optional AI estimate provider; all formatting checks work without it:
# RAPIDAPI_KEY=your_optional_key

# Optional document-aware AI interpretation (local assistant works without these):
# OPENAI_API_KEY=your_server_side_key
# ADF_AI_MODEL=your_available_responses_api_model
